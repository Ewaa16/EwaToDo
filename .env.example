# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=https://<proyek>.vercel.app
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Turso (libSQL). Di dev lokal bisa dibiarkan kosong -> pakai file ./data/local.db.
# Buat: https://turso.tech -> turso db create -> turso db show <nama> --url + --token
TURSO_DATABASE_URL=libsql://<nama>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Zona waktu tidak diatur lewat env: logika "hari ini"/statistik hard-code Asia/Jakarta
# di lib/jakarta.ts (Vercel me-reserved env TZ dan fungsi server selalu UTC).
